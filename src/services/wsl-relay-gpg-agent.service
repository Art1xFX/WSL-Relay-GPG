[Unit]
Description=WSL Relay for GnuPG cryptographic agent and passphrase cache
Documentation=man:gpg-agent(1)
Requires=wsl-relay-gpg-agent.socket

[Service]
ExecStart=%h/.local/bin/wsl-relay-gpg agent-socket

StandardInput=socket
StandardOutput=socket
StandardError=journal

CollectMode=inactive-or-failed
