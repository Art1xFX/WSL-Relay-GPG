[Unit]
Description=WSL Relay for GnuPG cryptographic agent and passphrase cache (access for web browsers)
Documentation=man:gpg-agent(1)
Requires=wsl-relay-gpg-agent-browser.socket

[Service]
ExecStart=%h/.local/bin/wsl-relay-gpg agent-browser-socket

StandardInput=socket
StandardOutput=socket
StandardError=journal

CollectMode=inactive-or-failed
