[Unit]
Description=WSL Relay for GnuPG network certificate management daemon
Documentation=man:dirmngr(8)
Requires=wsl-relay-dirmngr.socket

[Service]
ExecStart=%h/.local/bin/wsl-relay-gpg dirmngr-socket

StandardInput=socket
StandardOutput=socket
StandardError=journal

CollectMode=inactive-or-failed
