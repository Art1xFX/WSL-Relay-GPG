[Unit]
Description=WSL Relay for GnuPG cryptographic agent and passphrase cache (access for web browsers)
Documentation=man:gpg-agent(1)
Conflicts=gpg-agent-browser.socket

[Socket]
ListenStream=%t/gnupg/S.gpg-agent.browser

FileDescriptorName=browser
SocketMode=0600
DirectoryMode=0700

Accept=true
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
