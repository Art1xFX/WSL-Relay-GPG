[Unit]
Description=WSL Relay for GnuPG cryptographic agent and passphrase cache (restricted)
Documentation=man:gpg-agent(1)

[Socket]
ListenStream=%t/gnupg/S.gpg-agent.extra

FileDescriptorName=extra
SocketMode=0600
DirectoryMode=0700

Accept=true
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
