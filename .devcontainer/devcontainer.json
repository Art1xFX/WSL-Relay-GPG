{
  "name": "django-model-translation",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "runArgs": [
    "--security-opt=seccomp=unconfined"
  ],
  "features": {
    "ghcr.io/devcontainers/features/python:1.8.0": {
      "version": "3.14"
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false // cspell:disable-line
    },
    "ghcr.io/devcontainers-extra/features/uv:1.0.2": {
      "version": "0.12.5"
    }
  },
  "onCreateCommand": "sudo install -d -o vscode -g vscode /home/vscode/.uv /home/vscode/.uv/cache /home/vscode/.uv/venv /home/vscode/.cache /home/vscode/.cache/yarn",
  "postCreateCommand": {
    "python": "uv sync --locked",
    "js": "corepack yarn install --immutable",
    "commandhistory": "sudo chown -R $(whoami): /commandhistory" // cspell:disable-line
  },
  "remoteUser": "vscode",
  "containerEnv": {
    "UV_CACHE_DIR": "/home/vscode/.uv/cache",
    "UV_PROJECT_ENVIRONMENT": "/home/vscode/.uv/venv",
    "YARN_CACHE_FOLDER": "/home/vscode/.cache/yarn"
  },
  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/node_modules/.bin:${containerEnv:PATH}"
  },
  "mounts": [
    {
      // Cache and venv share one volume, so uv can create a hard link between them.
      "source": "django-model-translation-uv-data",
      "target": "/home/vscode/.uv",
      "type": "volume"
    },
    {
      "source": "django-model-translation-yarn-cache",
      "target": "/home/vscode/.cache/yarn",
      "type": "volume"
    },
    {
      "source": "django-model-translation-bashhistory", // cspell:disable-line
      "target": "/commandhistory", // cspell:disable-line
      "type": "volume"
    }
  ],
  "customizations": {
    "vscode": {
      "settings": {
        "[json][jsonc][jsonl]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode" // cspell:disable-line
        },
        // cspell:disable-next-line
        "[yaml][dockercompose]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode" // cspell:disable-line
        },
        "[toml]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode" // cspell:disable-line
        },
        "[markdown]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode" // cspell:disable-line
        },
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff" // cspell:disable-line
        },
        "ruff.importStrategy": "fromEnvironment",
        "prettier.documentSelectors": [
          "**/*.toml"
        ],
        "python-envs.defaultEnvManager": "ms-python.python:venv",
        "python-envs.defaultPackageManager": "ms-python.python:uv",
        "python-envs.alwaysUseUv": true,
        "python-envs.workspaceSearchPaths": [],
        "python.defaultInterpreterPath": "/home/vscode/.uv/venv/bin/python",
        "python.terminal.useEnvFile": true,
        "explorer.fileNesting.enabled": true,
        "explorer.fileNesting.patterns": {
          "pyproject.toml": "poetry.lock, uv.lock",
          "compose.yml": "compose.override.yml, compose.override.*.yml",
          "devcontainer.json": "devcontainer-lock.json"
        },
        "github.copilot.enable": {
          "*": true,
          "plaintext": false,
          "markdown": false,
          "scminput": false,
          "dotenv": false
        }
      },
      "extensions": [
        // cSpell:disable
        "streetsidesoftware.code-spell-checker",
        "ms-python.python",
        "ms-python.vscode-python-envs",
        "ms-python.vscode-pylance",
        "ms-vscode.makefile-tools",
        "charliermarsh.ruff",
        "esbenp.prettier-vscode",
        "redhat.vscode-yaml",
        "tamasfe.even-better-toml",
        "docker.docker",
        "EditorConfig.EditorConfig",
        "GitHub.vscode-pull-request-github",
        "github.vscode-github-actions"
        // cSpell:enable
      ]
    }
  }
}