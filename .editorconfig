root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
newline_at_end_of_file = true
trim_trailing_whitespace = true
max_line_length = 120

[Dockerfile]
indent_size = 4

[*.py]
indent_size = 4

[*.{json,jsonc}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2
